{
	"extends": "@tsconfig/node24/tsconfig.json",
	"compilerOptions": {
		"baseUrl": "./",
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "./dist",
		"sourceMap": true
	},
	"exclude": [
		"dist/**",
		"node_modules/**"
	],
	"include": [
		"src/**/*"
	]
}